# Copy to .env for local development. Everything here has a working default —
# a fresh clone runs with no edits and makes no paid calls.

# --- Agent runtime (apps/runtime-go) ---
SEXTANT_ADDR=:8080
SEXTANT_ALLOWED_ORIGINS=http://localhost:5173
SEXTANT_RETRIEVER_URL=http://localhost:8000
SEXTANT_TRACE_PATH=sextant-trace.sqlite

# "fake" (default) uses the in-process FakeProvider and never makes a network
# call. Set to "anthropic" only when you intend to spend money; the key is
# then required and the runtime refuses to start without it.
SEXTANT_PROVIDER=fake
# SEXTANT_PROVIDER_API_KEY=

SEXTANT_CHEAP_MODEL=claude-haiku-4-5-20251001
SEXTANT_STRONG_MODEL=claude-sonnet-5

# Per-run caps. Whichever trips first ends the run, and ending at a cap is a
# recorded outcome rather than an error.
SEXTANT_MAX_REPAIR_DEPTH=3
SEXTANT_BUDGET_USD=0.05
SEXTANT_WALL_CLOCK=30s
SEXTANT_ROW_LIMIT=500
SEXTANT_STATEMENT_TIMEOUT=10s

# The databases questions may be asked against, as slug=dialect:dsn pairs.
# The slug on a request is a key into this registry and is NEVER used as a
# path, so an unconfigured slug is refused rather than resolved. An empty
# value configures nothing and every question is refused — the same safe
# reading of "unset" that the origin allowlist uses.
# P1 is SQLite-only; postgres: is accepted by the parser and served from P3.
SEXTANT_DATABASES=toy=sqlite:../../infra/fixtures/toy.sqlite

# The guard parses through the retriever sidecar (PLAN.md 5.2). This is on the
# hot path of every question and fails CLOSED, so the timeout is a real bound
# and not a formality.
SEXTANT_PARSER_TIMEOUT=5s

# Abuse bounds. The per-run budget above caps one question; these cap a client
# and the server. P1 is the first phase that can spend real money.
SEXTANT_RATE_LIMIT_BURST=5
SEXTANT_RATE_LIMIT_PER_MINUTE=20
SEXTANT_MAX_CONCURRENT_RUNS=8

# Bounds the streamed result frame. Must not exceed MAX_RESULT_FRAME_CHARS in
# apps/web/src/lib/protocol.ts (4 MiB), or the runtime can emit a frame its own
# browser client rejects — which looks like a network fault, not a config error.
SEXTANT_MAX_RESULT_BYTES=1048576

# Trust X-Forwarded-For when identifying a client for rate limiting. Leave
# false unless this really is behind exactly one trusted proxy: the header is
# client-set, so believing it lets anyone mint a fresh identity per request.
SEXTANT_TRUST_PROXY=false

# --- Retriever (apps/retriever-python) ---
SEXTANT_RETRIEVER_PORT=8000
SEXTANT_EMBEDDING_MODEL=all-MiniLM-L6-v2
SEXTANT_TOP_K=10
SEXTANT_TABLE_BUDGET=20
SEXTANT_FK_HOPS=1

# --- Demo database (infra/docker-compose.yml) ---
POSTGRES_PASSWORD=sextant-local-dev
SEXTANT_READONLY_PASSWORD=sextant-readonly-local

# --- Published host ports (infra/docker-compose.yml) ---
# Override any that collide with something already running on this machine.
# A conflict makes the container look healthy while being unreachable from the
# browser, so it is worth checking before debugging anything else.
#
# On WSL2 the process holding a port may be running on WINDOWS, not in Linux.
# localhost is forwarded to the Windows host, so `ss -ltnp` inside WSL shows
# nothing listening and the conflict looks like it has no cause. The tell is
# `curl -sI localhost:8080` returning a real response — check its `Server:`
# header to identify what actually answered.
SEXTANT_RUNTIME_PORT=8080
SEXTANT_WEB_PORT=8081
SEXTANT_RETRIEVER_PORT_HOST=8000
SEXTANT_DB_PORT=5432
