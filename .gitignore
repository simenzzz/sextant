# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Node ------------------------------------------------------------------
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# --- Python ----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
htmlcov/
.coverage
.coverage.*

# --- Go --------------------------------------------------------------------
/apps/runtime-go/bin/

# --- Databases -------------------------------------------------------------
# Runtime SQLite files (trace store, quota, scratch) are never committed.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
# ...except the committed toy fixture the test suite and CI run against.
# Without this the whole pipeline would need a multi-GB download to go green.
!/infra/fixtures/toy.sqlite

# --- Data ------------------------------------------------------------------
# BIRD is multi-GB and license-gated: fetched by infra/scripts/fetch-bird.sh,
# never committed. Recorded provider responses can contain prompt text and are
# regenerated by `make eval`, so they are local artifacts too.
/eval/data/
/eval/fixtures/
# Eval *results* ARE committed (PLAN.md 6.5) — the run history is part of the
# story. Only the ignore-by-default trap is guarded against here.

# --- Claude Code -----------------------------------------------------------
# .claude/CLAUDE.md is the project's instructions and IS committed. The local
# settings file holds per-machine permission grants and is not shared.
.claude/settings.local.json

# --- Editors / OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
