# Pinned codegen toolchain — the single source for generate.sh, the Makefile's
# setup-codegen target, and CI. Every generator here produces different output
# across versions, and the generated code is committed and drift-gated, so a
# version bump must land in the same commit as the regenerated code.
GO_JSONSCHEMA_MODULE=github.com/atombender/go-jsonschema
GO_JSONSCHEMA_VERSION=v0.23.1
DATAMODEL_CODEGEN_VERSION=0.68.1
# json-schema-to-typescript is pinned in package.json / package-lock.json
